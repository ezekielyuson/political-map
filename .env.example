# Copy to .env and fill in. Never commit .env.

# FEC / open.fec.gov — register at https://api.data.gov/signup/
FEC_API_KEY=

# Congress.gov API — request at https://api.congress.gov/sign-up/
# Or reuse the same api.data.gov key as FEC.
CONGRESS_API_KEY=

# Senate LDA — register at https://lda.senate.gov/api/auth/register/
# Optional. Without a key, requests work but rate limits are tighter.
LDA_API_KEY=

# Optional: where the SQLite DB lives. Defaults to data/pge.db
# PGE_DB_PATH=data/pge.db
